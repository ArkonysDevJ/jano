# Copy this file to apps/api/.env (same folder, real values) --
# main.ts loads it automatically via `dotenv/config` on startup, no
# manual `export` needed in your shell.
PORT=3000
# Port 55432, not Postgres's default 5432 -- see docker-compose.yml's
# `ports` comment. Deliberately non-default: a machine that already
# runs a native/other Postgres on 5432 would otherwise have that
# service silently win the connection ahead of the jano-postgres
# container (same host, same port, two listeners) -- `docker compose
# ps` still reports the container "healthy" in that case, so the
# collision isn't visible there, only as a confusing password-auth
# error from the app itself. If your machine has nothing else on 5432,
# using 5432 here instead is fine -- just keep this value and
# docker-compose.yml's `ports` in sync.
DATABASE_URL=postgres://user:password@localhost:55432/jano

# Signing secret for session/refresh tokens (see auth/token.service.ts).
# Generate a real one per environment -- never reuse this example value.
# e.g.: openssl rand -base64 48
JWT_SECRET=change-this-value-before-running-the-api

# Lifetime secrets of the OPAQUE server (section 4) -- see
# cloudflare-opaque-server-provider.ts for why these are GLOBAL to the
# deployment, not per user. Generate them ONCE with:
#   node apps/api/scripts/generate-opaque-server-secrets.mjs
# Regenerating them invalidates ALL existing OPAQUE registrations --
# these are not secrets you casually regenerate per environment, treat
# them as production cryptographic material from the very first
# registration.
OPAQUE_OPRF_SEED_B64=
OPAQUE_AKE_PRIVATE_KEY_B64=
OPAQUE_AKE_PUBLIC_KEY_B64=
